---
import Navbar from "../components/Navbar.astro";
---

<section
  class="bg-[#285A43] bg-center bg-no-repeat bg-[url('./images/hero_floral.png')]"
>
 <Navbar/>
  <div class="px-4 mx-auto max-w-screen-xl text-center py-44">
    <h1
      class="mb-4 text-4xl font-extrabold tracking-tight leading-none text-white md:text-5xl"
    >
      Nature's Beauty Delivered to You
    </h1>
    <p class="text-lg font-normal text-gray-300 px-48">
      Nature's beauty is just a click away with our online flower and plant
      shop. We offer a wide variety of flowers that will bring a touch of nature
      to your home!
    </p>
    <div
      class="flex flex-col space-y-4 sm:flex-row sm:justify-center sm:space-y-0"
    >
      <a
        href="/"
        class="inline-flex justify-center items-center py-3 px-5 font-medium text-white bg-[#285A43] hover:bg-white hover:text-black"
        >Book Now</a
      >
      <a
        href="/"
        class="inline-flex justify-center items-center py-3 px-5 font-medium text-white ml-4 border border-white hover:bg-white hover:text-black"
        >Watch a Video</a
      >
    </div>
  </div>
</section>
